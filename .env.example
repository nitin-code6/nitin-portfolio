# GitHub Personal Access Token (for fetching pinned repositories, stars, etc.)
# Get one from: https://github.com/settings/tokens
# Scopes needed: public_repo
GITHUB_TOKEN=

# Email Service Configuration (e.g. Resend, SendGrid)
# We will use Resend as a lightweight, modern email provider
RESEND_API_KEY=

# Contact Form Delivery Email (Where you will receive the messages)
CONTACT_EMAIL=nitbit710@gmail.com
